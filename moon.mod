name = "Project2026-creator/qti-score"

version = "0.15.0"

readme = "README.md"

repository = "https://github.com/Project2026-creator/qti-score"

license = "Apache-2.0"

keywords = [ "qti", "assessment", "scoring", "education" ]

description = "A QTI 3 scoring kernel for choice, ordering, matching, gap filling, hottext, inline choice, sliders, composite items and numeric responses, ZIP packages and batch reports."

import {
  "Milky2018/xml@0.6.1",
  "moonbitlang/x@0.5.6",
  "moonbit-community/casefold@0.1.7",
  "moonbit-community/flate@0.9.0",
}
