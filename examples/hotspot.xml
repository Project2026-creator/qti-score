<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0" identifier="learning-space-hotspot" title="辨认学习空间中的合作区" adaptive="false" time-dependent="false">
  <qti-response-declaration identifier="RESPONSE" cardinality="single" base-type="identifier">
    <qti-correct-response><qti-value>Collaboration</qti-value></qti-correct-response>
  </qti-response-declaration>
  <qti-outcome-declaration identifier="SCORE" cardinality="single" base-type="float"/>
  <qti-item-body>
    <qti-hotspot-interaction response-identifier="RESPONSE">
      <qti-prompt>观察学习空间示意图，选择最适合小组讨论的位置。也可以使用图下的文字选项。</qti-prompt>
      <img src="graphic-map.svg" width="640" height="360" alt="学习空间平面图：左侧是资料阅读区，右侧是小组合作区，下方是展示区。"/>
      <qti-hotspot-choice identifier="Reading" shape="rect" coords="40,60,280,220" hotspot-label="资料阅读区"/>
      <qti-hotspot-choice identifier="Collaboration" shape="rect" coords="360,60,600,220" hotspot-label="小组合作区"/>
      <qti-hotspot-choice identifier="Presentation" shape="circle" coords="320,290,45" hotspot-label="成果展示区"/>
    </qti-hotspot-interaction>
  </qti-item-body>
  <qti-response-processing template="https://purl.imsglobal.org/spec/qti/v3p0/rptemplates/match_correct.xml"/>
</qti-assessment-item>
