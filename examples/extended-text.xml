<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0" identifier="reflection" title="课堂反馈反思" adaptive="false" time-dependent="false" xml:lang="zh-CN">
  <qti-response-declaration identifier="REFLECTION" cardinality="single" base-type="string"/>
  <qti-outcome-declaration identifier="SCORE" cardinality="single" base-type="float" external-scored="human"/>
  <qti-outcome-declaration identifier="REVIEW" cardinality="single" base-type="identifier"/>
  <qti-item-body>
    <qti-extended-text-interaction response-identifier="REFLECTION" expected-lines="6" expected-length="240" format="plain" min-strings="1" placeholder-text="写下具体情境、反馈依据与调整措施">
      <qti-prompt>请举一个课堂评价情境，说明教师如何根据学习者的反馈调整教学。作答将进入人工评阅。</qti-prompt>
    </qti-extended-text-interaction>
  </qti-item-body>
  <qti-response-processing>
    <qti-set-outcome-value identifier="SCORE"><qti-null/></qti-set-outcome-value>
    <qti-set-outcome-value identifier="REVIEW"><qti-base-value base-type="identifier">pending</qti-base-value></qti-set-outcome-value>
  </qti-response-processing>
  <qti-modal-feedback outcome-identifier="REVIEW" show-hide="show" identifier="pending" title="作答已提交">
    <qti-content-body><p>长文本作答已提交，等待人工评阅。当前分数尚未确定。</p></qti-content-body>
  </qti-modal-feedback>
</qti-assessment-item>
